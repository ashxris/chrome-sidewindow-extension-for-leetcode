{
  "manifest_version": 3,
  "name": "Chrome Side Window Extension",
  "version": "1.0.0",
  "description": "Docks a real, signed-in YouTube window to the right edge of your screen (1/3 or 1/4 width) so you can watch DSA tutorials while solving LeetCode.",
  "permissions": ["system.display", "storage"],
  "host_permissions": ["*://*.leetcode.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube DSA Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open/close the YouTube sidebar"
    }
  }
}
